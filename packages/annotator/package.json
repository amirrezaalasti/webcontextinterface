{
  "name": "@webcontextinterface/annotator",
  "version": "1.3.0",
  "description": "WCI annotator — derive data-wci-* annotations from unannotated HTML using accessibility semantics",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "prepublishOnly": "npm run build" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrezaalasti/webcontextinterface.git",
    "directory": "packages/annotator"
  },
  "homepage": "https://webcontextinterface.vercel.app/",
  "bugs": { "url": "https://github.com/amirrezaalasti/webcontextinterface/issues" },
  "dependencies": { "@webcontextinterface/spec": "^1.3.0" },
  "keywords": ["wci", "annotator", "accessibility", "agents", "web-context-interface"]
}
